# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL="postgresql://shams:shams@localhost:5432/shams_dev?schema=public"
APP_URL="http://localhost:3000"
# 32+ random characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
LOG_LEVEL=info
# Salt for privacy-preserving IP hashing in audit/rate-limit records.
IP_HASH_SALT="replace-me"

# Seed credentials (development/staging only)
SEED_OWNER_PASSWORD=""
SEED_STAFF_PASSWORD=""

# ── File storage ──────────────────────────────────────────────────────
# local = ./storage (dev). s3 = any S3-compatible service (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket serves product/marketing media; the private bucket must block all public access.
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BASE_URL=

# ── Payments ──────────────────────────────────────────────────────────
# Sandbox gateway for development/testing. NEVER enable in production.
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_SECRET="sandbox-webhook-secret-dev-only"
# Paymob (cards + wallets) — REQUIRES EXTERNAL CONFIG
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# ── Messaging ─────────────────────────────────────────────────────────
EMAIL_FROM="SHAMS <no-reply@shams.example>"
# Without RESEND_API_KEY, development writes emails to ./storage/dev-mail; production refuses to send.
RESEND_API_KEY=
SMS_PROVIDER_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────
REDIS_URL=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
SENTRY_DSN=
